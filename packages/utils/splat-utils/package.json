{
  "name": "@qunhe/egs-splat-utils",
  "version": "1.2.3",
  "description": "egs-splat-utils",
  "main": "index.js",
  "module": "index.js",
  "type": "module",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts"
    }
  },
  "license": "MIT",
  "repository": "https://github.com/manycoretech/egs.git",
  "release": {
    "scripts": {
      "pre-release": "pnpm build:release"
    },
    "publishRoot": "./build"
  },
  "scripts": {
    "build": "pnpm egs-build --cp ./sort-wasm/sort.js ./sort-wasm/sort.d.ts",
    "build:wasm": "cd sort-wasm && cmake --workflow --preset emscripten-wasm32",
    "build:release": "pnpm build --release",
    "build:types": "pnpm build --type-only",
    "build:types:release": "pnpm build --release --type-only"
  },
  "dependencies": {
    "@qunhe/egs": "^1.2.103",
    "@qunhe/egs-lib": "^1.0.3",
    "@qunhe/egs-splat-loader": "^1.3.1",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
